<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Required-reason API declarations. Without this file an upload is rejected
  outright (ITMS-91053: "Missing API declaration") before a build ever
  reaches TestFlight — quill uses all four categories below.

  Tracking and collected-data are empty, and that is the literal truth
  rather than a posture: audio, transcripts, and notes never leave the
  device, there is no account, no analytics, and no network call except the
  whisper/qwen model downloads and the sideload version manifest.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Model choice, language allow-set, enhance prompt, onboarding
			     flag — all this app's own settings. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Trash purge reads contentModificationDate to drop entries
			     older than 7 days (AppState.purgeTrash). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- ModelCatalog refuses a multi-gigabyte model download that
			     wouldn't fit, rather than letting it die at 90%. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
